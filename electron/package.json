{
  "name": "versena",
  "version": "1.1.0",
  "description": "VerseNa - AI 角色扮演聊天桌面客户端",
  "main": "main.js",
  "author": "wxw",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.versena.app",
    "productName": "VerseNa",
    "directories": {
      "output": "../dist-electron"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../build/windows/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*.py",
          "**/*.json",
          "**/*.txt",
          "**/*.md",
          "**/*.yaml",
          "**/*.yml",
          "!data/**",
          "!tests/**",
          "!**/.pytest_cache/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../themepacks",
        "to": "themepacks",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../themes",
        "to": "themes",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../personas",
        "to": "personas",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "artifactName": "VerseNa-${version}-Setup-${arch}.${ext}",
      "signAndEditExecutable": false,
      "signDlls": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VerseNa",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^25.0.0"
  }
}
