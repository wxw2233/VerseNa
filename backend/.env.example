# Optional. If omitted in LAN mode, VerseNa generates a token on first start,
# stores it in backend/data/access_token, and prints it in the startup panel.
VERSENA_HOST=0.0.0.0
VERSENA_PORT=8002
VERSENA_TOOL_WORKSPACE=
# VERSENA_ACCESS_TOKEN=replace-with-a-token-at-least-6-characters

# Keep false for trusted HTTP LAN access. Set true only when serving through HTTPS.
VERSENA_AUTH_COOKIE_SECURE=false
VERSENA_AUTH_SESSION_TTL=604800
